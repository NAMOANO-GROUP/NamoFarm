SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Required. Must be a strong random string (>= 16 chars). The server refuses to
# start without it. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret

# Comma-separated list of allowed web origins (e.g. your Vercel domain).
# If left empty, all origins are accepted (not recommended in production).
CORS_ORIGIN=https://your-app.vercel.app

# SMTP configuration for real password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change_this_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=NamoFarm
SMTP_REPLY_TO=support@example.com

# Optional public URL used to build clickable reset links in the email
# Example Flutter web route: http://localhost:8090/#/reset-password
PASSWORD_RESET_URL=http://localhost:8090/#/reset-password
APP_WEB_URL=http://localhost:8090
